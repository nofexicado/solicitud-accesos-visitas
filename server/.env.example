# Copiar como server/.env y completar. En desarrollo, `npm run dev:db` lo genera solo.
NODE_ENV=production
# La API escucha solo en loopback: nginx es el único que le habla.
HOST=127.0.0.1
PORT=3100
PUBLIC_URL=https://accesos.ejemplo.com

DATABASE_URL=postgres://accesos_app:CAMBIAR@127.0.0.1:5432/accesos_visitas
DATABASE_URL_MIGRATOR=postgres://accesos_migrator:CAMBIAR@127.0.0.1:5432/accesos_visitas

# Tres claves distintas, 32+ caracteres cada una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
QR_SECRET=
INDUCCION_SECRET=

DATA_DIR=D:\AccesosVisitas\data
LOG_DIR=D:\AccesosVisitas\logs
UPLOAD_MAX_MB=10

# Cada upload se escanea con Microsoft Defender (MpCmdRun -Scan -ScanType 3 -File) antes de
# aceptarse. Si el escaneo detecta algo o falla (timeout, Defender ausente) el archivo se rechaza.
# En producción va en true; false solo en desarrollo.
AV_ENABLED=true
AV_MPCMDRUN=C:\Program Files\Windows Defender\MpCmdRun.exe
AV_TIMEOUT_SEG=60

# Mails: con MAIL_ENABLED=false (o sin configuración) quedan en cola como "pendiente" y se
# envían al activarlo. MAIL_PROVIDER=smtp | graph
MAIL_ENABLED=false
MAIL_PROVIDER=smtp
# PLACEHOLDER: la casilla todavía no está definida. Cambiarla acá cuando exista; el portal la muestra
# como contacto y es el remitente de todos los mails.
MAIL_FROM=accesos@ejemplo.com
MAIL_FROM_NAME=Accesos a yacimientos

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Microsoft Graph (app registration con permiso de aplicación Mail.Send)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=accesos@ejemplo.com
